{
  "name": "@dakera-ai/langchain",
  "version": "0.4.0",
  "description": "LangChain.js integration for Dakera AI memory platform",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests examples",
    "typecheck": "tsc --noEmit && tsc -p tests/tsconfig.json",
    "typecheck:examples": "tsc -p examples/tsconfig.json"
  },
  "keywords": [
    "langchain",
    "dakera",
    "memory",
    "vector",
    "ai",
    "rag",
    "typescript"
  ],
  "author": "Dakera Team",
  "license": "MIT",
  "homepage": "https://github.com/dakera-ai/dakera-langchain-js",
  "repository": {
    "type": "git",
    "url": "https://github.com/dakera-ai/dakera-langchain-js"
  },
  "bugs": {
    "url": "https://github.com/dakera-ai/dakera-langchain-js/issues"
  },
  "peerDependencies": {
    "@dakera-ai/dakera": "^0.12.3",
    "@langchain/core": ">=1.1.0"
  },
  "devDependencies": {
    "@dakera-ai/dakera": "^0.12.3",
    "@eslint/js": "^10.0.1",
    "@langchain/core": "^1.1.41",
    "@types/node": "^26.1.2",
    "eslint": "^10.13.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "overrides": {
    "uuid": "^14.0.0",
    "langsmith": ">=0.6.0"
  }
}
